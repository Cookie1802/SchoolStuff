# Process mask data into dictionary of {ROI_ID : [(x,y)...()]} - id coordinates dict
# Initialize a dictionary to store the IDs and their coordinates (already done previously)
def make_coordinate_dictionary(mask_data):
        id_coordinates_dict = {}
        # Collect coordinates for each ID in the mask_data
        for y in range(mask_data.shape[0]):  # Iterate through rows (Y-axis)
            for x in range(mask_data.shape[1]):  # Iterate through columns (X-axis)
                current_id = mask_data[y, x]
                if current_id != 0:  # Exclude ID 0
                    if current_id not in id_coordinates_dict:
                        id_coordinates_dict[current_id] = []
                    id_coordinates_dict[current_id].append((x, y))
        return id_coordinates_dict

def check_channel_intensity(cyan_data, green_data, magenta_data, img_name):
    """Prints the max intensity values for each channel in a TIFF file to verify ordering."""
    max_cyan = np.max(cyan_data)
    max_green = np.max(green_data)
    max_magenta = np.max(magenta_data)

    print(f"Max intensity values for {img_name}:")
    print(f"  Cyan Channel: {max_cyan}")
    print(f"  Green Channel: {max_green}")
    print(f"  Magenta Channel: {max_magenta}")

def destack_tiff(filepath):
    """Reads a multi-channel TIFF file and extracts cyan, green, and magenta channels."""
    img_array = tifffile.imread(filepath)  # Load TIFF image

    if img_array.ndim == 3 and img_array.shape[0] == 3:  # (Channels, H, W) format
        img_array = np.transpose(img_array, (1, 2, 0))  # Rearrange to (H, W, Channels)
    
    if img_array.ndim == 3 and img_array.shape[-1] == 3:  # Now (H, W, 3)
        cyan_data = img_array[:, :, 0]
        green_data = img_array[:, :, 1]
        magenta_data = img_array[:, :, 2]
    else:
        raise ValueError(f"Unexpected TIFF shape {img_array.shape} in {filepath}")

    return cyan_data, green_data, magenta_data

def average_roi_colours(id_coordinates_dict, cyan_data, green_data, magenta_data):
    # Initialize output dict {ROI_ID : (avg_cyan, avg_green, avg_magenta)}
    avg_colours = {}
    """
    Iterate over all ROIs in mask dict
        For each ROI initialize an output colour intensity list
        For each point in each ROI:
            - Access corresponding point in all 3 colour arrays
            - Append intensity value to respective colour list
        Average all 3 lists and store in output dict
    """
    if len(id_coordinates_dict) == 0:
        return {}
    
    for roi_id in id_coordinates_dict: # Iterate over all ROIs
        col_intensity_list = []
        for coordinate in id_coordinates_dict[roi_id]: # Iterate over all ROI data points
            x, y = coordinate
            c_intensity = cyan_data[y, x]
            g_intensity = green_data[y, x]
            m_intensity = magenta_data[y, x]
            col_intensity_list.append((c_intensity, g_intensity, m_intensity))
        # TODO consider anomaly detection/removal of myelin based on
        # potentially flat thresholding
        # also consider impact of normalisation of each colour channel before/after averaging
        avg_c = sum(col[0] for col in col_intensity_list) / len(col_intensity_list)
        avg_g = sum(col[1] for col in col_intensity_list) / len(col_intensity_list)
        avg_m = sum(col[2] for col in col_intensity_list) / len(col_intensity_list)
        
        avg_colours[roi_id] = (avg_c, avg_g, avg_m)
    
    return avg_colours

def export_data(avg_colours, czi_img_path, czi_folder):
    roi_ids = list(avg_colours.keys())
    
    avg_cyan_values = [avg_colours[roi][0] for roi in roi_ids]
    avg_green_values = [avg_colours[roi][1] for roi in roi_ids]
    avg_magenta_values = [avg_colours[roi][2] for roi in roi_ids]

    # Create output DataFrame including both average values and classification
    output_df = pd.DataFrame({
        "roi_id": roi_ids,
        "cyan_intensity": avg_cyan_values,
        "green_intensity": avg_green_values,
        "magenta_intensity": avg_magenta_values,
    })

    outfile_name = f"out_{czi_img_path.split('.')[0]}.csv"
    outfile_path = os.path.join(OUTPUT_FOLDER, czi_folder, outfile_name)
    output_df.to_csv(outfile_path, index=False, sep="\t")

