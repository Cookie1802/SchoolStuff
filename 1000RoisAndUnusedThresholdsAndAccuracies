def plot_histogram(data, color_name, img_name):
    """Generates and saves a histogram of fluorescence intensity for a given channel."""
    # Ensure the output folder exists
    os.makedirs(OUTPUT_FOLDER, exist_ok=True)

    print(f"Generating histogram for {color_name} channel of {img_name}")
    print(f"Data range: {np.min(data)} to {np.max(data)}")  # Print min and max of data

    """Generates and saves a histogram of fluorescence intensity for a given channel."""
    plt.hist(data.ravel(), bins=300, range=(0, 300), color=color_name, alpha=0.6)
    plt.title(f"{color_name} Channel Histogram: {img_name}")
    plt.xlabel("Intensity")
    plt.ylabel("Frequency")
    plt.show()
    plt.savefig(f"{OUTPUT_FOLDER}/{color_name}_histogram_{img_name}.png")
    plt.close()

# Process mask data into dictionary of {ROI_ID : [(x,y)...()]} - id coordinates dict
# Initialize a dictionary to store the IDs and their coordinates (already done previously)
def make_coordinate_dictionary(mask_data):
        id_coordinates_dict = {}
        # Collect coordinates for each ID in the mask_data
        for y in range(mask_data.shape[0]):  # Iterate through rows (Y-axis)
            for x in range(mask_data.shape[1]):  # Iterate through columns (X-axis)
                current_id = mask_data[y, x]
                if current_id != 0:  # Exclude ID 0
                    if current_id not in id_coordinates_dict:
                        id_coordinates_dict[current_id] = []
                    id_coordinates_dict[current_id].append((x, y))
        return id_coordinates_dict

