# Destacks a czi file into 3 numpy arrays (per channel)
def destack_czi(filepath, brightness_factor=0.1):
    print(filepath)
    # Destack czi file into separate channels
    array6d, mdata = read_tools.read_6darray(filepath, chunk_zyx=False)
    cyan_data = array6d[0][0][0][0]
    green_data = array6d[0][0][1][0]
    magenta_data = array6d[0][0][2][0]

    # Apply brightness factor if needed
    cyan_data = np.clip(cyan_data * brightness_factor, 0, 255).astype(np.uint8)
    green_data = np.clip(green_data * brightness_factor, 0, 255).astype(np.uint8)
    magenta_data = np.clip(magenta_data * brightness_factor, 0, 255).astype(np.uint8)

    return cyan_data, green_data, magenta_data

