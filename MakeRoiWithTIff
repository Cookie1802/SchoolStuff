# Destacks a czi file into 3 numpy arrays (per channel)
def destack_czi(filepath):
    print(filepath)
    # Destack czi file into separate channels
    array6d, mdata = read_tools.read_6darray(filepath, chunk_zyx=False)
    cyan_data = array6d[0][0][0][0]
    green_data = array6d[0][0][1][0]
    magenta_data = array6d[0][0][2][0]

    return cyan_data, green_data, magenta_data


