def compute_roi_centers(id_coordinates_dict):
    """Computes the center (x, y) of each ROI from the list of coordinates."""
    roi_centers = {}
    for roi_id, coords in id_coordinates_dict.items():
        # Compute mean x and y to find the centroid
        x_center = int(np.mean([x for x, y in coords]))
        y_center = int(np.mean([y for x, y in coords]))
        roi_centers[roi_id] = (x_center, y_center)
    
    return roi_centers

