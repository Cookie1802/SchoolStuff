def average_roi_colours(id_coordinates_dict, cyan_data, green_data, magenta_data):
    # Initialize output dict {ROI_ID : (avg_cyan, avg_green, avg_magenta)}
    avg_colours = {}
    """
    Iterate over all ROIs in mask dict
        For each ROI initialize an output colour intensity list
        For each point in each ROI:
            - Access corresponding point in all 3 colour arrays
            - Append intensity value to respective colour list
        Average all 3 lists and store in output dict
    """
    if len(id_coordinates_dict) == 0:
        return {}
    
    for roi_id in id_coordinates_dict: # Iterate over all ROIs
        col_intensity_list = []
        for coordinate in id_coordinates_dict[roi_id]: # Iterate over all ROI data points
            x, y = coordinate
            c_intensity = cyan_data[y, x]
            g_intensity = green_data[y, x]
            m_intensity = magenta_data[y, x]
            col_intensity_list.append((c_intensity, g_intensity, m_intensity))
        # TODO consider anomaly detection/removal of myelin based on
        # potentially flat thresholding
        # also consider impact of normalisation of each colour channel before/after averaging
        avg_c = sum(col[0] for col in col_intensity_list) / len(col_intensity_list)
        avg_g = sum(col[1] for col in col_intensity_list) / len(col_intensity_list)
        avg_m = sum(col[2] for col in col_intensity_list) / len(col_intensity_list)
        
        avg_colours[roi_id] = (avg_c, avg_g, avg_m)
    
    return avg_colours

