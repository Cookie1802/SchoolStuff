def merge_csvs_for_virus(virus_folder):
    """Merges all CSV files in a virus folder into a single DataFrame, adding Mouse ID."""
    all_files = [f for f in os.listdir(virus_folder) if f.endswith(".csv")]
    dataframes = []

    for file in all_files:
        file_path = os.path.join(virus_folder, file)
        df = pd.read_csv(file_path, sep=",")  
        
        # Extract mouse ID from filename (assuming file names are "out_Mouse1.csv", etc.)
        mouse_id = os.path.splitext(file)[0].replace("out_", "")  
        df["Mouse_ID"] = mouse_id  # Add Mouse ID column

        dataframes.append(df)

    if not dataframes:
        print(f"No CSV files found in {virus_folder}")
        return None

    merged_df = pd.concat(dataframes, ignore_index=True)
    return merged_df

